generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum Status {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  password          String
  name              String
  role              Role                 @default(STUDENT)
  dormInfo          String?              // Block, Room etc.
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  requests          MaintenanceRequest[] @relation("StudentRequests")
  assignments       MaintenanceRequest[] @relation("StaffAssignments")
  notifications     Notification[]
  sentNotifications Notification[]       @relation("Sender")
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String
  priority    Priority @default(MEDIUM)
  status      Status   @default(PENDING)
  
  // Relations
  studentId   String
  student     User     @relation("StudentRequests", fields: [studentId], references: [id])
  
  staffId     String?
  staff       User?    @relation("StaffAssignments", fields: [staffId], references: [id])
  
  dormInfo    String   // Specific location for this request
  attachments Attachment[]
  
  notes       String?  // Resolution notes or staff comments
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  history     RequestHistory[]

  @@index([status])
  @@index([studentId])
  @@index([staffId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g., "CREATE_REQUEST", "UPDATE_STATUS"
  entity    String   // e.g., "MaintenanceRequest"
  entityId  String?
  userId    String
  details   String?  // JSON string of changes
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}


model Attachment {
  id        String             @id @default(uuid())
  url       String
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  senderId  String?
  sender    User?    @relation("Sender", fields: [senderId], references: [id])
  
  message   String
  read      Boolean  @default(false)
  type      String?  // e.g., "STATUS_UPDATE", "NEW_ASSIGNMENT"
  link      String?  // Link to the request
  
  createdAt DateTime @default(now())
}

model RequestHistory {
  id        String             @id @default(uuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
  status    Status
  comment   String?
  createdAt DateTime           @default(now())
}
